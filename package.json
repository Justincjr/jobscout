{
  "name": "job-scout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --use-system-ca --import tsx --watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --use-system-ca dist/server/index.js",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:live": "tsx scripts/live-smoke.ts",
    "test:sources:live": "tsc -p tsconfig.tools.json && node --use-system-ca .cache/tools/scripts/source-smoke.js",
    "benchmark": "tsc -p tsconfig.tools.json && node .cache/tools/scripts/benchmark.js",
    "recover": "tsx scripts/recover.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "he": "2.0.0",
    "openai": "7.34.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/he": "1.2.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
