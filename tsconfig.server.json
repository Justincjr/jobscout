{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowJs": true,
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": false
  },
  "include": ["src/server", "src/storage", "src/shared", "src/modules", "src/providers", "src/tasks"],
  "exclude": ["src/client"]
}
